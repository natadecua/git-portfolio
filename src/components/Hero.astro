---
import { syncedAgo } from '~/lib/format';
import portfolio from '~/data/portfolio.json';

const synced = syncedAgo(portfolio.synced_at);
---
<header style="padding: var(--s-7) var(--s-6) var(--s-6);">
  <div class="hero-top">
    <span class="label">N° 01 — Index</span>
    <span class="label">2026</span>
  </div>
  <h1 class="hero-title">My portfolio<span class="accent">.</span></h1>
  <p class="identity mono">Nathanael Tan Cua · Computer Engineer · Philippines</p>
  <div class="hero-meta">
    <span class="dot" aria-hidden="true"></span>
    <span class="mono" style="color: var(--muted);">{synced}</span>
    <span class="mono" style="color: var(--muted);">·</span>
    <a class="mono" href="https://github.com/natadecua" style="color: var(--muted);">github.com/natadecua</a>
  </div>
</header>
<style>
  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
  }

  .hero-title {
    margin-top: var(--s-3);
    max-width: 14ch;
    text-wrap: balance;
  }

  .hero-meta {
    margin-top: var(--s-4);
    display: flex;
    gap: var(--s-4);
    align-items: center;
    flex-wrap: wrap;
  }

  .identity {
    margin-top: var(--s-5);
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in oklch, var(--accent) 60%, transparent);
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .dot { box-shadow: none; }
  }

  @media (max-width: 760px) {
    header {
      padding: var(--s-6) var(--s-4) var(--s-5);
    }

    .hero-title {
      max-width: 100%;
      text-wrap: pretty;
      font-size: clamp(2.2rem, 10vw, 3.5rem);
    }

    .hero-meta {
      gap: var(--s-3);
    }
  }
</style>
