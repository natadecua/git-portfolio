---
import portfolio from '~/data/portfolio.json';
import { percent } from '~/lib/format';

const weeks = portfolio.activity_52w as number[];
const max = Math.max(1, ...weeks);
const peakIdx = weeks.indexOf(max);
const langs = Object.entries(portfolio.languages_overall as Record<string, number>)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6);

const totalCommits = weeks.reduce((a, b) => a + b, 0);
const activeWeeks = weeks.filter(w => w > 0).length;

const now = new Date();
const monthLabels: string[] = [];
for (let i = 51; i >= 0; i--) {
  const d = new Date(now);
  d.setDate(d.getDate() - i * 7);
  monthLabels.push(d.toLocaleString('en', { month: 'short' }));
}
const labelPositions: { label: string; idx: number }[] = [];
let lastLabel = '';
monthLabels.forEach((label, idx) => {
  if (label !== lastLabel) { labelPositions.push({ label, idx }); lastLabel = label; }
});
---
<section style="padding: var(--s-7) var(--s-6); border-top: 1px solid var(--hairline);">
  <div class="section-head">
    <span class="label">Rhythm</span>
    <span class="label mono" style="color:var(--muted); font-size:0.72rem;">
      {totalCommits} commits · {activeWeeks} active weeks
    </span>
  </div>

  <div class="chart-wrap" aria-label="52-week activity chart">
    <div class="month-labels mono" aria-hidden="true">
      {labelPositions.map(({ label, idx }) => (
        <span class="month-tick" style={`left: ${(idx / 52) * 100}%`}>{label}</span>
      ))}
    </div>
    <div class="bars" role="img" aria-label={`52-week commits. Peak week has ${max} commits.`}>
      {weeks.map((w, i) => {
        const h = Math.max(8, Math.round((w / max) * 100));
        return (
          <span
            class={`bar ${i === peakIdx ? 'peak' : ''} ${w === 0 ? 'zero' : ''}`}
            style={`--h:${h}%;`}
            title={`Week ${i + 1}: ${w} commits`}
          />
        );
      })}
    </div>
    {max > 0 && (
      <span class="peak-label mono" style={`left: ${(peakIdx / 52) * 100}%`}>
        peak: {max}
      </span>
    )}
  </div>

  <hr class="hairline" style="margin: var(--s-5) 0;" />

  <ul class="langs">
    {langs.map(([name, ratio]) => {
      const pct = Math.max(0, Math.min(100, Math.round(ratio * 100)));
      return (
        <li>
          <span class="lang-name">{name}</span>
          <span class="lang-bar"><span class="lang-fill" style={`width:${pct}%`} /></span>
          <span class="mono lang-pct">{percent(ratio)}</span>
        </li>
      );
    })}
  </ul>
</section>
<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--s-4);
  }

  .chart-wrap {
    position: relative;
    margin-top: var(--s-4);
    padding-top: var(--s-2);
    padding-bottom: var(--s-5);
  }

  .month-labels {
    position: relative;
    height: 1.2em;
    font-size: 0.62rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    margin-bottom: var(--s-1);
  }

  .month-tick {
    position: absolute;
    transform: translateX(-50%);
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(52, minmax(0, 1fr));
    align-items: end;
    gap: 2px;
    min-height: 100px;
    height: 120px;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--s-2);
  }

  .bar {
    display: block;
    height: var(--h);
    background: color-mix(in oklch, var(--ink) 38%, transparent);
    border-radius: 999px;
    min-height: 2px;
    transition: height 220ms var(--ease-out), background-color 180ms var(--ease-out);
  }

  .bar.zero {
    opacity: 0.24;
    height: 8%;
  }

  .bar.peak {
    background: var(--accent);
  }

  .peak-label {
    position: absolute;
    font-size: 0.62rem;
    color: var(--accent);
    transform: translateX(-50%);
    margin-top: var(--s-1);
    white-space: nowrap;
  }

  .langs { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-3); }
  .langs li { display: grid; grid-template-columns: 10ch 1fr auto; gap: var(--s-4); align-items: center; }
  .lang-name { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; }
  .lang-bar {
    position: relative;
    height: 8px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--ink) 10%, transparent);
    overflow: hidden;
  }
  .lang-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background: color-mix(in oklch, var(--ink) 45%, transparent);
  }
  .lang-pct { color: var(--muted); min-width: 4ch; text-align: right; font-size: 0.78rem; }

  @media (max-width: 760px) {
    section {
      padding: var(--s-6) var(--s-4);
    }

    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }

    .bars {
      height: 96px;
      min-height: 84px;
    }

    .langs li {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }

    .lang-pct {
      text-align: left;
    }
  }
</style>
