---
import fs from 'node:fs/promises';
import path from 'node:path';
import { marked } from 'marked';
import { relativeTime } from '~/lib/format';
interface Props {
  name: string;
  description: string;
  language: string | null;
  stars: number;
  html_url: string;
  topics: string[];
  pushed_at: string;
  readme_path: string;
}
const { name, description, language, stars, html_url, topics, pushed_at, readme_path } = Astro.props;
const raw = await fs.readFile(path.join(process.cwd(), readme_path), 'utf8').catch(() => '');
const html = raw ? marked.parse(raw, { breaks: true }) : '';
---
<div class="detail">
  <header class="detail-head">
    <div>
      <span class="label">Project</span>
      <h2>{name}<span class="accent">.</span></h2>
      {description && <p class="desc">{description}</p>}
    </div>
    <div class="detail-actions">
      <a class="external mono" href={html_url} rel="noopener" target="_blank">View on GitHub ↗</a>
      <button class="close-btn mono" data-close-detail aria-label="Close project detail">Close ↑</button>
    </div>
  </header>

  <div class="chips mono">
    {language && <span class="chip">{language}</span>}
    <span class="chip">★ {stars}</span>
    <span class="chip">Updated {relativeTime(pushed_at)}</span>
    {topics.slice(0, 6).map(t => <span class="chip topic">#{t}</span>)}
  </div>

  <hr class="hairline" />

  {html
    ? <article class="readme" set:html={html} />
    : (
      <div class="empty-state mono">
        {description
          ? <p class="empty-desc">{description}</p>
          : <p class="empty">No README provided.</p>}
      </div>
    )}
</div>

<style>
  .detail { padding: var(--s-4) 0 var(--s-3); }

  .detail-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-bottom: var(--s-4);
  }

  .detail-head h2 {
    margin-top: var(--s-2);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .desc {
    margin-top: var(--s-3);
    color: var(--muted);
    font-size: 1rem;
    max-width: 60ch;
  }

  .detail-actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-shrink: 0;
  }

  .external {
    color: var(--accent);
    font-size: 0.78rem;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .external:hover { border-bottom-color: var(--accent); }

  .close-btn {
    background: none;
    border: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 0.72rem;
    padding: 4px 10px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 150ms var(--ease-out), border-color 150ms var(--ease-out);
  }
  .close-btn:hover { color: var(--ink); border-color: var(--ink); }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    color: var(--muted);
    margin: var(--s-4) 0;
    font-size: 0.74rem;
  }
  .chip {
    padding: 4px 10px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
  }
  .chip.topic { opacity: 0.75; }

  .empty {
    color: var(--muted);
    padding: var(--s-5) 0;
    text-align: center;
    font-size: 0.85rem;
  }

  .empty-state {
    padding: var(--s-5) 0 var(--s-4);
  }

  .empty-desc {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 60ch;
  }

  .readme {
    max-width: 70ch;
    margin: var(--s-4) auto 0;
  }
  .readme :global(h1) { font-family: var(--font-display); font-size: 1.4rem; margin-top: var(--s-5); margin-bottom: var(--s-3); }
  .readme :global(h2) { font-family: var(--font-display); font-size: 1.2rem; margin-top: var(--s-5); margin-bottom: var(--s-3); }
  .readme :global(h3) { font-family: var(--font-display); font-size: 1.05rem; margin-top: var(--s-4); margin-bottom: var(--s-2); }
  .readme :global(p), .readme :global(li) { font-size: 0.95rem; line-height: 1.65; }
  .readme :global(p) { margin: var(--s-3) 0; }
  .readme :global(ul), .readme :global(ol) { padding-left: var(--s-5); margin: var(--s-3) 0; }
  .readme :global(pre) {
    font-family: var(--font-mono);
    background: color-mix(in oklch, var(--ink) 6%, transparent);
    padding: var(--s-4);
    overflow-x: auto;
    border-radius: 4px;
    font-size: 0.82rem;
    line-height: 1.5;
    margin: var(--s-3) 0;
  }
  .readme :global(code) { font-family: var(--font-mono); font-size: 0.88em; }
  .readme :global(:not(pre) > code) {
    background: color-mix(in oklch, var(--ink) 6%, transparent);
    padding: 1px 6px;
    border-radius: 3px;
  }
  .readme :global(a) { color: var(--accent); border-bottom: 1px solid currentColor; }
  .readme :global(img) { max-width: 100%; border-radius: 2px; }
  .readme :global(blockquote) {
    padding-left: var(--s-4);
    margin: var(--s-3) 0;
    border-left: 1px solid var(--hairline);
    color: var(--muted);
  }
  .readme :global(table) { border-collapse: collapse; margin: var(--s-3) 0; font-size: 0.9rem; }
  .readme :global(th), .readme :global(td) {
    border-bottom: 1px solid var(--hairline);
    padding: var(--s-2) var(--s-3);
    text-align: left;
  }
</style>
