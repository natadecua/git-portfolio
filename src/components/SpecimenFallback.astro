---
import fs from 'node:fs/promises';
import path from 'node:path';
interface Props { name: string; size?: number }
const { name, size = 120 } = Astro.props;
const svg = await fs.readFile(path.join(process.cwd(), 'public/specimens', `${name}.svg`), 'utf8');
---
<div class="specimen-fallback" style={`width:${size}px;height:${size}px`} set:html={svg} aria-hidden="true" />
<style>
  .specimen-fallback { color: var(--ink); display: block; }
  .specimen-fallback svg { width: 100%; height: 100%; }
</style>
