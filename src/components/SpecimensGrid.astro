---
import portfolio from '~/data/portfolio.json';
import { relativeTime } from '~/lib/format';
import SpecimenFallback from './SpecimenFallback.astro';
import Specimen from './Specimen.tsx';
import ProjectDetail from './ProjectDetail.astro';
---
<section class="works-section">
  <div class="section-head">
    <span class="label">Selected works</span>
    <span class="label">{portfolio.repos.length} repos</span>
  </div>
  <hr class="hairline" />

  <div class="grid">
    {portfolio.repos.map((r, i) => (
      <details class="card" name="project">
        <summary class="card-summary">
          <div class="card-top">
            <span class="rank mono">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="title">{r.name}</h3>
            <div class="meta mono">
              <span>{r.language ?? '—'}</span>
              <span class="sep">·</span>
              <span>★ {r.stars}</span>
              <span class="sep">·</span>
              <span>{relativeTime(r.pushed_at)}</span>
            </div>
          </div>
          <div class="specimen">
            <SpecimenFallback name={r.name} size={120} />
            <Specimen client:only="react" params={r.specimen} size={120} />
          </div>
        </summary>
        <div class="card-body">
          <ProjectDetail
            name={r.name}
            description={r.description}
            language={r.language}
            stars={r.stars}
            html_url={r.html_url}
            topics={r.topics}
            pushed_at={r.pushed_at}
            readme_path={r.readme_path}
          />
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .works-section {
    padding: 0 var(--s-6) var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--s-5) 0 var(--s-3);
    gap: var(--s-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s-6) var(--s-4);
    padding-top: var(--s-6);
  }

  .card {
    position: relative;
    transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-4);
  }

  .card[open] {
    grid-column: 1 / -1;
    transform: none;
  }

  /* When any card is open, dim the others */
  .grid:has(.card[open]) .card:not([open]) {
    opacity: 0.35;
  }

  .card-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-3) var(--s-5);
  }
  .card-summary::-webkit-details-marker { display: none; }

  .card-top {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .rank {
    font-size: 0.62rem;
    color: var(--muted);
    letter-spacing: 0.15em;
  }

  .specimen {
    position: relative;
    width: 120px;
    height: 120px;
    transition: transform 320ms var(--ease-out);
    isolation: isolate;
    align-self: flex-start;
  }
  .specimen > div { position: absolute; inset: 0; }
  .specimen > div:last-child { z-index: 1; }

  .specimen :global(.specimen-fallback) {
    transition: opacity 180ms var(--ease-out);
  }

  .specimen.has-webgl :global(.specimen-fallback) {
    opacity: 0;
  }

  .card:hover .specimen,
  .card:focus-within .specimen { transform: scale(1.05); }

  .card:hover,
  .card:focus-within {
    transform: translateY(-2px);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    margin: 0;
    transition: color 180ms var(--ease-out);
    line-height: 1.2;
  }
  .card:hover .title,
  .card[open] .title { color: var(--accent); }

  .meta {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
  }
  .sep { opacity: 0.4; }

  .card-body {
    border-top: 1px solid var(--hairline);
    padding: var(--s-5) 0 var(--s-6);
    max-width: 70ch;
    margin: 0 auto;
    animation: fadeUp 320ms var(--ease-out);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 760px) {
    .works-section {
      padding: 0 var(--s-4) var(--s-7);
    }

    .section-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }

    .card-summary {
      padding: var(--s-3) var(--s-2) var(--s-4);
    }

    .specimen { width: 96px; height: 96px; }
    .title { font-size: 0.95rem; }
    .meta { font-size: 0.64rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .specimen, .card { transition: none; }
    .card-body { animation: none; }
  }
</style>

<script>
  const grid = document.querySelector('.grid') as HTMLElement | null;
  if (grid) {
    const markWebGlSpecimens = () => {
      const allSpecimens = grid.querySelectorAll<HTMLElement>('.specimen');
      allSpecimens.forEach((node) => {
        if (node.querySelector('canvas')) node.classList.add('has-webgl');
      });
    };

    markWebGlSpecimens();
    const observer = new MutationObserver(markWebGlSpecimens);
    observer.observe(grid, { childList: true, subtree: true });

    const cards = () => Array.from(grid.querySelectorAll<HTMLDetailsElement>('details.card'));

    function openCard(el: HTMLDetailsElement) {
      cards().forEach(c => { if (c !== el) c.removeAttribute('open'); });
      el.setAttribute('open', '');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
    }

    function closeOpen() {
      cards().forEach(c => c.removeAttribute('open'));
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeOpen();
    });

    grid.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-close-detail]');
      if (!btn) return;
      const card = btn.closest('details.card') as HTMLDetailsElement | null;
      if (card) card.removeAttribute('open');
    });
  }
</script>
