---
import portfolio from '~/data/portfolio.json';
import { relativeTime } from '~/lib/format';
import SpecimenFallback from './SpecimenFallback.astro';
import Specimen from './Specimen.tsx';
import ProjectDetail from './ProjectDetail.astro';
---
<section style="padding: 0 var(--s-6) var(--s-7);">
  <div class="section-head">
    <span class="label">Selected works</span>
    <span class="label">{portfolio.repos.length} repos</span>
  </div>
  <hr class="hairline" />

  <div class="grid">
    {portfolio.repos.map((r, i) => (
      <details class="card" name="project">
        <summary class="card-summary">
          <span class="rank mono">{String(i + 1).padStart(2, '0')}</span>
          <div class="specimen">
            <SpecimenFallback name={r.name} size={140} />
            <Specimen client:only="react" params={r.specimen} size={140} />
          </div>
          <h3 class="title">{r.name}</h3>
          <div class="meta mono">
            <span>{r.language ?? '—'}</span>
            <span class="sep">·</span>
            <span>★ {r.stars}</span>
            <span class="sep">·</span>
            <span>{relativeTime(r.pushed_at)}</span>
          </div>
        </summary>
        <div class="card-body">
          <ProjectDetail
            name={r.name}
            description={r.description}
            language={r.language}
            stars={r.stars}
            html_url={r.html_url}
            topics={r.topics}
            pushed_at={r.pushed_at}
            readme_path={r.readme_path}
          />
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--s-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-6) var(--s-5);
    padding-top: var(--s-6);
  }

  .card {
    position: relative;
    transition: opacity 220ms var(--ease-out);
  }

  .card[open] {
    grid-column: 1 / -1;
  }

  /* When any card is open, dim the others */
  .grid:has(.card[open]) .card:not([open]) {
    opacity: 0.35;
  }

  .card-summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-3) var(--s-6);
    text-align: center;
    position: relative;
  }
  .card-summary::-webkit-details-marker { display: none; }

  .rank {
    position: absolute;
    top: var(--s-4);
    left: var(--s-3);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.15em;
  }

  .specimen {
    position: relative;
    width: 140px;
    height: 140px;
    transition: transform 320ms var(--ease-out);
  }
  .specimen > div { position: absolute; inset: 0; }
  .specimen > div:last-child { z-index: 1; }

  .card:hover .specimen,
  .card:focus-within .specimen { transform: scale(1.08); }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    margin: 0;
    transition: color 180ms var(--ease-out);
  }
  .card:hover .title,
  .card[open] .title { color: var(--accent); }

  .meta {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
    justify-content: center;
  }
  .sep { opacity: 0.4; }

  .card-body {
    border-top: 1px solid var(--hairline);
    padding: var(--s-5) 0 var(--s-6);
    max-width: 70ch;
    margin: 0 auto;
    animation: fadeUp 320ms var(--ease-out);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 540px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--s-5) var(--s-4); }
    .specimen { width: 100px; height: 100px; }
    .title { font-size: 0.95rem; }
    .meta { font-size: 0.66rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .specimen, .card { transition: none; }
    .card-body { animation: none; }
  }
</style>

<script>
  const grid = document.querySelector('.grid') as HTMLElement | null;
  if (grid) {
    const cards = () => Array.from(grid.querySelectorAll<HTMLDetailsElement>('details.card'));

    function openCard(el: HTMLDetailsElement) {
      cards().forEach(c => { if (c !== el) c.removeAttribute('open'); });
      el.setAttribute('open', '');
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function closeOpen() {
      cards().forEach(c => c.removeAttribute('open'));
    }

    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).tagName === 'INPUT') return;
      const all = cards();
      const openIdx = all.findIndex(c => c.hasAttribute('open'));

      if (e.key === 'Escape') { closeOpen(); return; }
      if (e.key === 'j' || e.key === 'ArrowDown') {
        e.preventDefault();
        const next = openIdx < all.length - 1 ? openIdx + 1 : 0;
        openCard(all[next]);
      }
      if (e.key === 'k' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = openIdx > 0 ? openIdx - 1 : all.length - 1;
        openCard(all[prev]);
      }
    });

    grid.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-close-detail]');
      if (!btn) return;
      const card = btn.closest('details.card') as HTMLDetailsElement | null;
      if (card) card.removeAttribute('open');
    });
  }
</script>
